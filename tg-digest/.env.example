# Скопируй этот файл в .env и заполни.

# my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# @BotFather -> /newbot -> токен вида 12345:AAF...
BOT_TOKEN=

# Нужен ТОЛЬКО если в config.json стоит "backend": "gemini".
# При backend "claude-cli" (по умолчанию) оставь пустым.
GEMINI_API_KEY=
