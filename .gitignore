# Ничего из этого не должно уехать в публичный репозиторий.
# Правила намеренно продублированы с .gitignore внутри подпапок: цена промаха
# здесь — утёкший доступ к почте, оценкам или Telegram-аккаунту.
#
# ВНИМАНИЕ: комментарий в .gitignore работает только с начала строки.
# Запись вида "*.log  # пояснение" — это НЕ шаблон с комментарием, а буквальный
# шаблон вместе с решёткой и текстом, который не совпадает ни с чем.
# Именно так здесь однажды и утёк лог в индекс.

# --- корень: только приложение ---------------------------------------------
# Эта папка заодно рабочая папка учёбы: домашки, силлабусы, скриншоты. Поэтому
# в корне игнорируется всё, кроме перечисленного ниже, — новая личная папка не
# попадёт в репозиторий, даже если забыть дописать под неё правило.
# Новая папка приложения в корне — добавь её сюда строкой `!/<папка>/`.
/*
!/.github/
!/.gitignore
!/README.md
!/VERSION
!/LICENSE
!/install.bat
!/install.sh
!/installer/
!/groups/
!/rubezh/
!/tg-digest/

# --- ключи и живые сессии ---------------------------------------------------
.env
# secrets.json: JWT портала, sesskey Moodle, ссылка на календарь, chat_id
secrets.json
# config.json: id личных чатов
config.json
# рабочие копии данных группы; исходник для группы — groups/<группа>/
rubezh/schedule.json
rubezh/syllabus.json
# *.session: university.session — это ПОЛНЫЙ доступ к аккаунту Telegram
*.session
*.session-journal
# .sessions/: профили Chromium с куками Moodle, Outlook и портала
.sessions/

# --- состояние и логи -------------------------------------------------------
state.json
# digest.log перечисляет, в каких группах ты состоишь
*.log

# --- сборка и мусор ---------------------------------------------------------
build/
# rubezh/bin/: cloudflared, скачанный для `rubezh.py phone`
rubezh/bin/
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# --- документы университета -------------------------------------------------
# Силлабусы и академический календарь — документы AITU, а не наш код.
# Правила оценивания и даты из них выписаны в README, файлы не нужны.
*.pdf

# Ярлыки Windows — привязаны к конкретной машине
*.lnk

# Скриншоты расписания с телефона — личное, в репозиторий не идут
scheduel/

# Учебное задание по ICT — не часть проекта
docs/ict-assignment/

# venv из install.sh / install.bat
.venv/

# --- сборка установщика ---------------------------------------------------
installer/dist/
installer/build/
installer/out/
.gstack/
